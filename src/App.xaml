<Application x:Class="MojarraNav.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <!-- Colores (los mismos de MojarraCut) -->
    <Color x:Key="cBg">#0F1115</Color>
    <SolidColorBrush x:Key="Bg" Color="#0F1115"/>
    <SolidColorBrush x:Key="Panel" Color="#161921"/>
    <SolidColorBrush x:Key="Panel2" Color="#1C2029"/>
    <SolidColorBrush x:Key="Panel3" Color="#232834"/>
    <SolidColorBrush x:Key="Linea" Color="#2A2F3A"/>
    <SolidColorBrush x:Key="Texto" Color="#E6E8EE"/>
    <SolidColorBrush x:Key="Tenue" Color="#8F97A8"/>
    <SolidColorBrush x:Key="Acento" Color="#7C6CFF"/>
    <SolidColorBrush x:Key="Acento2" Color="#A99DFF"/>
    <SolidColorBrush x:Key="AcentoSuave" Color="#337C6CFF"/>
    <SolidColorBrush x:Key="Claude" Color="#D97757"/>
    <SolidColorBrush x:Key="Ok" Color="#22C55E"/>
    <SolidColorBrush x:Key="Peligro" Color="#EF4444"/>
    <SolidColorBrush x:Key="Estrella" Color="#FACC15"/>
    <FontFamily x:Key="Iconos">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Style TargetType="{x:Type ToolTip}">
      <Setter Property="Background" Value="#232834"/>
      <Setter Property="Foreground" Value="#E6E8EE"/>
      <Setter Property="BorderBrush" Value="#2A2F3A"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- Botón de icono -->
    <Style x:Key="BtnIcono" TargetType="{x:Type Button}">
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Foreground" Value="{StaticResource Texto}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="FontFamily" Value="{StaticResource Iconos}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="7">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#232834"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="#2A2F3A"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#A99DFF"/><Setter TargetName="b" Property="BorderThickness" Value="1"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.3"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="BtnIconoChico" TargetType="{x:Type Button}" BasedOn="{StaticResource BtnIcono}">
      <Setter Property="Width" Value="26"/><Setter Property="Height" Value="26"/><Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- Botones de la ventana (minimizar, maximizar, cerrar) -->
    <Style x:Key="BtnVentana" TargetType="{x:Type Button}">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Foreground" Value="{StaticResource Texto}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="FontFamily" Value="{StaticResource Iconos}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="b" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#232834"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="BtnCerrarVentana" TargetType="{x:Type Button}" BasedOn="{StaticResource BtnVentana}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="b" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#C42B1C"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Botón con texto -->
    <Style x:Key="Btn" TargetType="{x:Type Button}">
      <Setter Property="Foreground" Value="{StaticResource Texto}"/>
      <Setter Property="Background" Value="{StaticResource Panel2}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Linea}"/>
      <Setter Property="Padding" Value="11,5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#3A4150"/><Setter TargetName="b" Property="Opacity" Value="0.92"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#A99DFF"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="BtnPrimario" TargetType="{x:Type Button}" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="{StaticResource Acento}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Acento}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="BtnClaude" TargetType="{x:Type Button}" BasedOn="{StaticResource Btn}">
      <Setter Property="Height" Value="32"/>
      <Setter Property="Background">
        <Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#2ED97757" Offset="0"/><GradientStop Color="#2E7C6CFF" Offset="1"/></LinearGradientBrush></Setter.Value>
      </Setter>
      <Setter Property="BorderBrush" Value="#73D97757"/>
    </Style>
    <Style x:Key="Chip" TargetType="{x:Type Button}" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="12,5"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#7C6CFF"/><Setter TargetName="b" Property="Background" Value="#1A7C6CFF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Cajas de texto sin borde (van dentro de un Border propio) -->
    <Style x:Key="TextoLimpio" TargetType="{x:Type TextBox}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource Texto}"/>
      <Setter Property="CaretBrush" Value="{StaticResource Texto}"/>
      <Setter Property="SelectionBrush" Value="{StaticResource Acento}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type TextBox}">
            <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" Focusable="False" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Lista desplegable oscura -->
    <Style x:Key="ComboToggle" TargetType="{x:Type ToggleButton}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ToggleButton}">
            <Border x:Name="b" Background="#1C2029" BorderBrush="#2A2F3A" BorderThickness="1" CornerRadius="6">
              <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Iconos}" FontSize="9" Foreground="#8F97A8" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,7,0"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#3A4150"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="{x:Type ComboBoxItem}">
      <Setter Property="Foreground" Value="{StaticResource Texto}"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ComboBoxItem}">
            <Border x:Name="b" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="b" Property="Background" Value="#232834"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="#337C6CFF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="{x:Type ComboBox}">
      <Setter Property="Foreground" Value="{StaticResource Texto}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ComboBox}">
            <Grid>
              <ToggleButton Style="{StaticResource ComboToggle}" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"/>
              <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" Margin="8,0,22,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
              <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Top" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                <Border Background="#161921" BorderBrush="#2A2F3A" BorderThickness="1" CornerRadius="8" Padding="4" MinWidth="{TemplateBinding ActualWidth}" Margin="0,0,0,4">
                  <ScrollViewer MaxHeight="300"><StackPanel IsItemsHost="True"/></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Menús oscuros -->
    <Style TargetType="{x:Type ContextMenu}">
      <Setter Property="Foreground" Value="{StaticResource Texto}"/>
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="HasDropShadow" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ContextMenu}">
            <Border Background="#1C2029" BorderBrush="#2A2F3A" BorderThickness="1" CornerRadius="8" Padding="4" MinWidth="230">
              <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="{x:Type Separator}">
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="{x:Type Separator}"><Border Height="1" Background="#2A2F3A" Margin="6,4"/></ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="{x:Type MenuItem}">
      <Setter Property="Foreground" Value="{StaticResource Texto}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type MenuItem}">
            <Grid>
              <Border x:Name="b" Background="Transparent" CornerRadius="5" Padding="10,6">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="14"/></Grid.ColumnDefinitions>
                  <ContentPresenter ContentSource="Icon" VerticalAlignment="Center" TextElement.FontFamily="{StaticResource Iconos}" TextElement.FontSize="13"/>
                  <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="#8F97A8" Margin="24,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                  <TextBlock x:Name="flecha" Grid.Column="3" Text="&#xE76C;" FontFamily="{StaticResource Iconos}" FontSize="9" VerticalAlignment="Center" HorizontalAlignment="Right" Visibility="Collapsed"/>
                </Grid>
              </Border>
              <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsSubmenuOpen}" Placement="Right" AllowsTransparency="True" Focusable="False" HorizontalOffset="2">
                <Border Background="#1C2029" BorderBrush="#2A2F3A" BorderThickness="1" CornerRadius="8" Padding="4" MinWidth="180">
                  <StackPanel IsItemsHost="True"/>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="b" Property="Background" Value="#2A2F3A"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
              <Trigger Property="HasItems" Value="True"><Setter TargetName="flecha" Property="Visibility" Value="Visible"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Barras de desplazamiento finas -->
    <Style TargetType="{x:Type ScrollBar}">
      <Setter Property="Width" Value="8"/>
      <Setter Property="MinWidth" Value="8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ScrollBar}">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb><Thumb><Thumb.Template><ControlTemplate><Border Background="#3A4150" CornerRadius="4" Margin="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
