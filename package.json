{
  "name": "mojarranav",
  "productName": "MojarraNav",
  "version": "0.1.0",
  "description": "Navegador web de Mojarrium con Claude integrado",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "electron . --test",
    "icon": "electron scripts/icono.js",
    "iconos": "node scripts/iconos.js && node -e \"require('fs').copyFileSync('ui/iconos.js','paginas/iconos.js')\"",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "lucide-static": "^0.460.0"
  },
  "build": {
    "appId": "com.mojarrium.mojarranav",
    "productName": "MojarraNav",
    "files": [
      "main.js",
      "marca.js",
      "datos.js",
      "claude.js",
      "puente.js",
      "mcp.js",
      "preload-ui.js",
      "preload-pagina.js",
      "CLAUDE.md",
      "ui/**",
      "paginas/**",
      "build/icon.png"
    ],
    "asarUnpack": [
      "mcp.js"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "es_ES"
      ],
      "language": "3082",
      "shortcutName": "MojarraNav"
    }
  },
  "author": "Emilio"
}
